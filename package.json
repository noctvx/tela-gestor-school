{
  "name": "schoolfix",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma escolar SchoolFix com autenticação por RA",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "create-admin": "node scripts/create-admin.js",
    "check": "node --check server.js && node --check login.js && node --check script.js && node --check scripts/create-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.3.1"
  },
  "overrides": {
    "mysql2": "$mysql2"
  }
}
